{
  "name": "unihorarios",
  "productName": "unihorarios",
  "version": "1.0.0",
  "description": "My Electron application description",
  "main": ".vite/build/main.js",
  "scripts": {
    "build": "electron-forge package",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "echo \"No linting configured\"",
    "dist": "electron-builder"
  },
  "keywords": [],
  "author": {
    "name": "David Gonzalo",
    "email": "drdavidgonzalogomez2001@gmail.com"
  },
  "build": {
    "extraFiles": [
      {
        "from": "src/data",
        "to": "src/data",
        "filter": [
          "**/*"
        ]
      }
    ],
    "appId": "com.davidgonzalo.unihorarios",
    "files": [
      ".vite/build/**/*",
      ".vite/renderer/**/*",
      "src/data/**/*"
    ]
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.8.3",
    "@electron-forge/maker-deb": "^7.8.3",
    "@electron-forge/maker-rpm": "^7.8.3",
    "@electron-forge/maker-squirrel": "^7.8.3",
    "@electron-forge/maker-zip": "^7.8.3",
    "@electron-forge/plugin-auto-unpack-natives": "^7.8.3",
    "@electron-forge/plugin-fuses": "^7.8.3",
    "@electron-forge/plugin-vite": "^7.8.3",
    "@electron/fuses": "^1.8.0",
    "@rollup/plugin-babel": "^6.1.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "electron": "37.4.0",
    "electron-builder": "^26.0.12",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "@electron/rebuild": "^4.0.1",
    "@fullcalendar/interaction": "^6.1.19",
    "@fullcalendar/timegrid": "^6.1.19",
    "@fullcalendar/vue3": "^6.1.19",
    "electron-is-packaged": "^1.0.2",
    "electron-squirrel-startup": "^1.0.1",
    "pinia": "^3.0.3",
    "sqlite3": "^5.1.7",
    "vue": "^3.5.20",
    "vue-router": "^4.5.1"
  }
}
